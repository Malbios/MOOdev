<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Ansi.fs" />
    <Compile Include="LspClient.fs" />
    <Compile Include="Monaco.fs" />
    <Compile Include="App.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Fable.Browser.Dom" Version="2.20.0" />
    <PackageReference Include="Fable.Browser.WebSocket" Version="1.4.0" />
    <PackageReference Include="Fable.Core" Version="5.2.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Fable-compilability confirmed live (Phase 0 spike): Language.Lexer
         cross-compiles cleanly to JS, so the sugar<->real conversion
         (Language.Sugar) runs client-side, no extra round trip. -->
    <ProjectReference Include="..\Language\Language.fsproj" />
  </ItemGroup>

</Project>
