<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="ResolverTests.fs" />
    <Compile Include="LoaderTests.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Metadata\Metadata.fsproj" />
    <!-- Test-only: reuses Sidecar.Exporter's renderers to build synthetic
         FORMAT.md-conformant fixture trees (mirrors
         Sidecar.Tests/TreeParserTests.fs's own convention) rather than
         duplicating that rendering logic here. Does not affect the shipped
         Metadata.dll/LanguageServer.dll dependency graph - Metadata.fsproj
         itself has no reference to Sidecar.fsproj. -->
    <ProjectReference Include="..\..\src\Sidecar\Sidecar.fsproj" />
  </ItemGroup>

</Project>
