<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="AstQueryTests.fs" />
    <Compile Include="HandlerTests.fs" />
    <Compile Include="InlayHintTests.fs" />
    <Compile Include="DeadVerbFinderTests.fs" />
    <Compile Include="PropertyDeadReferenceFinderTests.fs" />
    <Compile Include="ObjectReferenceFinderTests.fs" />
    <Compile Include="GotchaFinderTests.fs" />
    <Compile Include="PermissionRiskFinderTests.fs" />
    <Compile Include="CallGraphTests.fs" />
    <Compile Include="VerbSummaryTests.fs" />
    <Compile Include="VerbMetricsTests.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\LanguageServer\LanguageServer.fsproj" />
    <!-- Test-only: reuses Sidecar.Exporter's renderers to build a synthetic
         FORMAT.md-conformant fixture tree for HandlerTests.fs, mirroring
         Metadata.Tests.fsproj's own identical addition. Does not affect the
         shipped LanguageServer.dll dependency graph. -->
    <ProjectReference Include="..\..\src\Sidecar\Sidecar.fsproj" />
  </ItemGroup>

</Project>
